---
import { Link } from '@lucide/svelte';
import { owner } from '../lib/config';

const { title } = Astro.props;
---

<aside
    class="flex flex-1 flex-col md:flex-row xl:flex-col gap-6 md:gap-12 xl:gap-9 mt-6 xl:mt-0 xl:sticky xl:top-32"
>
    <div>
        <div class="mb-2 text-sm text-gray-500 uppercase">Written By</div>
        <div class="flex items-center gap-2">
            <div class="avatar">
                <div class="w-12 rounded-xl">
                    <img src={owner.displayPicture} alt={owner.displayName} />
                </div>
            </div>
            <div class="flex flex-col gap-1">
                <span class="block text-lg leading-5">{owner.displayName}</span>
                <span class="text-xs text-gray-500">{owner.shortTitle}</span>
            </div>
        </div>
    </div>
    <div>
        <div class="mb-2 text-sm text-gray-500 uppercase">
            Share This Article
        </div>
        <div class="flex flex-wrap gap-1">
            <button
                class="btn btn-sm shadow"
                title="Share this article to WhatsApp"
                data-share="whatsapp"
            >
                <svg
                    role="img"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                >
                    <path
                        d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
                    ></path>
                </svg>
                WhatsApp
            </button>
            <button
                class="btn btn-sm shadow"
                title="Share this article to Telegram"
                data-share="telegram"
            >
                <svg
                    role="img"
                    viewBox="0 0 24 24"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                >
                    <path
                        d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"
                    ></path>
                </svg>
                Telegram
            </button>
            <button
                class="btn btn-sm shadow"
                title="Share this article to LinkedIn"
                data-share="linkedin"
            >
                <svg
                    role="img"
                    viewBox="0 0 16 16"
                    xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4"
                    fill="currentColor"
                >
                    <path
                        d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"
                    ></path>
                </svg>
                LinkedIn
            </button>
            <button
                class="btn btn-sm shadow"
                title="Copy link to this article"
                data-copy-link
            >
                <Link size={16} /> Copy Link
            </button>
        </div>
    </div>
</aside>

<script is:inline define:vars={{ title: encodeURIComponent(title) }}>
    const buttonCopyLink = document.querySelector('[data-copy-link]');
    const originalButtonCopyLinkText = buttonCopyLink?.innerHTML;
    let copyTimeout;

    const shareUrls = {
        whatsapp: url =>
            `https://wa.me/?text=${encodeURIComponent(`${title}\n${url}`)}`,
        telegram: url => `https://t.me/share/url?url=${url}&text=${title}`,
        linkedin: url =>
            `https://www.linkedin.com/shareArticle?mini=true&url=${url}`,
    };

    document.querySelectorAll('[data-share]').forEach(button => {
        button.addEventListener('click', () => {
            const url = encodeURIComponent(window.location.href);
            const shareUrl = shareUrls[button.dataset.share]?.(url);

            if (shareUrl)
                window.open(shareUrl, '_blank', 'noopener,noreferrer');
        });
    });

    buttonCopyLink?.addEventListener('click', async () => {
        const url = window.location.href;

        try {
            await navigator.clipboard.writeText(url);

            if (copyTimeout) clearTimeout(copyTimeout);
            buttonCopyLink.innerHTML = `<span>Copied!</span>`;

            copyTimeout = setTimeout(() => {
                buttonCopyLink.innerHTML = originalButtonCopyLinkText;
            }, 2000);
        } catch (e) {
            console.error('Failed to copy link:', e);
        }
    });
</script>
