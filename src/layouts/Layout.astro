---
import '../styles/global.css';
import 'aos/dist/aos.css';
import { imageSizeFromFile } from 'image-size/fromFile';
import { metadata } from '../lib/config';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const { pageTitle, articleMetadata } = Astro.props;

const defaultFavicon = '/res/favicon.png';
const imageDimensions = await imageSizeFromFile('./public' + defaultFavicon);

const formattedTitle = pageTitle
    ? `${pageTitle} | ${metadata.title}`
    : metadata.title;
const siteUrl = import.meta.env.DEV
    ? Astro.url.origin
    : import.meta.env.PUBLIC_SITE_URL.replace(/\/+$/, '');

const openGraph = {
    image: {
        url: defaultFavicon,
        width: imageDimensions?.width,
        height: imageDimensions?.height,
    },
    ...metadata,
    ...articleMetadata,
};
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/png" href={defaultFavicon} />

        <title>{formattedTitle}</title>
        <meta name="description" content={metadata.description} />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:title" content={formattedTitle} />
        <meta property="og:site_name" content={openGraph.siteName} />
        <meta property="og:description" content={openGraph.description} />
        <meta
            property="og:image:url"
            content={new URL(openGraph.image.url, siteUrl).href}
        />
        <meta property="og:image:width" content={openGraph.image.width} />
        <meta property="og:image:height" content={openGraph.image.height} />
        <meta property="og:type" content={openGraph.type} />
        <meta
            property="og:url"
            content={new URL(Astro.url.pathname, siteUrl).href}
        />
        {
            !!openGraph?.author && (
                <meta property="article:author" content={openGraph.author} />
            )
        }
        {
            !!openGraph?.section && (
                <meta property="article:section" content={openGraph.section} />
            )
        }
        {
            !!openGraph?.publishedTime && (
                <meta
                    property="article:published_time"
                    content={openGraph.publishedTime}
                />
            )
        }

        <script
            src="https://www.googletagmanager.com/gtag/js?id=UA-131278165-1"
            async></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];

            function gtag() {
                dataLayer.push(arguments);
            }

            gtag('js', new Date());
            gtag('config', 'UA-131278165-1');
        </script>
    </head>

    <body
        class="flex flex-col w-full min-h-screen overflow-auto"
        data-theme="light"
    >
        <div style="display: contents">
            <Header />
            <slot />
            <Footer type={openGraph.type} />
        </div>
    </body>
</html>
