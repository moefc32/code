---
// @ts-nocheck
import { getCollection, render } from 'astro:content';
import { ChevronRight, House } from '@lucide/svelte';
import Layout from '../../layouts/Layout.astro';
import { blog } from '../../lib/config';
import datePrettier from '../../lib/datePrettier';

export async function getStaticPaths() {
    const posts = await getCollection('blog');

    return posts.map(post => ({
        params: {
            slug: post.id,
        },
        props: {
            post,
        },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout pageTitle={post.data.title}>
    <section
        class="flex flex-1 flex-col gap-6 mx-auto mt-6 mb-12 px-12 pt-28 leading-8 w-full max-w-screen-lg"
    >
        <nav class="flex items-center gap-2 text-gray-500 text-sm uppercase">
            <a
                href="/"
                class="inline-flex items-center gap-1 hover:text-blue-500"
            >
                <House size={16} />
                {import.meta.env.PUBLIC_APP_NAME}
            </a>
            <ChevronRight size={16} />
            <a href={blog.path} class="hover:text-blue-500">
                {blog.title.long}
            </a>
        </nav>
        <article class="flex flex-col gap-6">
            <h1
                class="text-3xl lg:text-[2.5rem] font-semibold leading-9 lg:leading-12"
            >
                {post.data.title}
            </h1>
            <p class="text-gray-500">
                Published {
                    datePrettier(Math.trunc(post.data.date.getTime() / 1000), {
                        date: true,
                    })
                }
            </p>
            <div
                class:list={[
                    'prose max-w-none mt-3',
                    'prose-h2:my-6 prose-h3:my-4 prose-li:prose-p:my-0',
                ]}
            >
                <Content />
            </div>
        </article>
    </section>
</Layout>
